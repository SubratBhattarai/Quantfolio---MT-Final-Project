# ── Root .dockerignore ───────────────────────────────────────────────────────
# Applied to the entire build context (the project root).
# Each service Dockerfile uses a sub-directory as its context, so these also
# take effect within backend/ and frontend/ as appropriate.

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/

# SQLite — do NOT bake the dev database into the image.
# The DB is managed by the named Docker volume.
*.db
*.db-journal
*.db-wal
*.db-shm

# Node / Frontend
node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dev tooling & IDE
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# Git
.git/
.gitignore

# Docs / test artifacts (not needed in image)
docs/
*.md
STORY.txt
